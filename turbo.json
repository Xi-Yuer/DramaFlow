{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "CREDENTIAL_ENCRYPTION_KEY",
    "API_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "ALLOWED_ORIGIN",
    "WEB_ORIGIN",
    "PORT",
    "API_PORT",
    "WORKER_CONCURRENCY",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "TRUSTED_PROXY_CIDRS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@dramaflow/database#test": {
      "dependsOn": ["build", "@dramaflow/contracts#build"],
      "outputs": [],
      "cache": false
    },
    "@dramaflow/database#typecheck": {
      "dependsOn": ["build", "@dramaflow/contracts#build"],
      "outputs": []
    }
  }
}
