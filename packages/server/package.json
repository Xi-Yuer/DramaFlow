{
  "name": "@dramaflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "3.1030.0",
    "@dramaflow/contracts": "workspace:^",
    "@dramaflow/database": "workspace:*",
    "@dramaflow/workflow": "workspace:^",
    "@dramaflow/plugins": "workspace:^",
    "@langchain/core": "1.2.18",
    "@langchain/langgraph-checkpoint": "1.2.0",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@nestjs/common": "^12.0.1",
    "bullmq": "6.3.18",
    "ioredis": "5.11.1",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  }
