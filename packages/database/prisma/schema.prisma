generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// 表名必须用 @@map 写成 lowercase snake_case，不依赖 PostgreSQL 双引号保留大小写。

// 业务模型由用户逐步指导后添加。

model User {
  id                  String               @id
  name                String               @db.VarChar(80)
  email               String               @unique @db.VarChar(254)
  emailVerified       Boolean              @default(false)
  image               String?
  role                String               @default("user") @db.VarChar(32)
  banned              Boolean              @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  accounts            Account[]
  profile             UserProfile?
  projects            Project[]
  modelProviders      ModelProvider[]
  modelConfigurations ModelConfiguration[]

  @@map("auth_user")
}

model UserProfile {
  userId    String   @id
  bio       String   @default("") @db.VarChar(280)
  locale    String   @default("zh-CN") @db.VarChar(32)
  timeZone  String   @default("Asia/Shanghai") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limit")
}

// 项目保存基础画布信息；Workflow 定义与运行入口独立接入。
model Project {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String
  name         String        @db.VarChar(80)
  revision     Int           @default(1)
  viewport     Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workflow     Workflow?
  nodeRuns     NodeRun[]
  workflowRuns WorkflowRun[]
  artifacts    Artifact[]

  @@index([ownerId, updatedAt, id])
  @@map("canvas_project")
}

model Workflow {
  id        String            @id @default(uuid())
  projectId String            @unique @db.Uuid
  name      String            @db.VarChar(80)
  draft     Json
  revision  Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  WorkflowVersion[]

  @@map("workflow")
}

// 每个版本独立保存完整定义；迁移中的触发器禁止更新已创建版本。
model WorkflowVersion {
  id             String   @id @default(uuid())
  workflowId     String
  version        Int
  sourceRevision Int
  definition     Json
  createdAt      DateTime @default(now())
  workflow       Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@unique([workflowId, sourceRevision])
  @@index([workflowId])
  @@map("workflow_version")
}

// 运行仍保存逻辑版本 ID，由 Runner 经版本 Repository 核对归属；本轮不调整运行外键。
model WorkflowRun {
  id                String                    @id @default(uuid())
  projectId         String                    @db.Uuid
  workflowId        String
  workflowVersionId String
  invocationKey     String
  threadId          String                    @unique
  status            String                    @default("pending")
  inputs            Json
  outputs           Json?
  error             Json?
  createdAt         DateTime                  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  project           Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodeRuns          NodeRun[]
  nodeOccurrences   NodeOccurrence[]
  waitingRevision   Int                       @default(0)
  executions        WorkflowExecutionOutbox[]
  artifacts         Artifact[]

  @@unique([id, projectId])
  @@unique([workflowId, invocationKey])
  @@index([projectId])
  @@index([workflowId])
  @@index([workflowVersionId])
  @@index([status])
  @@map("workflow_run")
}

// scopeKey 当前为 root；未来由受信任的 scoped execution 显式提供，不解析其字符串结构。
model NodeOccurrence {
  id            String      @id @default(uuid()) @db.Uuid
  projectId     String      @db.Uuid
  workflowRunId String
  nodeId        String
  scopeKey      String
  createdAt     DateTime    @default(now())
  workflowRun   WorkflowRun @relation(fields: [workflowRunId, projectId], references: [id, projectId], onDelete: Cascade)
  attempts      NodeRun[]

  @@unique([workflowRunId, scopeKey, nodeId])
  @@unique([id, workflowRunId, projectId, nodeId])
  @@map("node_occurrence")
}

model NodeRun {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @db.Uuid
  workflowRunId String
  nodeId        String
  occurrenceId  String         @db.Uuid
  attempt       Int
  status        String         @default("running")
  inputs        Json?
  outputs       Json?
  error         Json?
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun   WorkflowRun    @relation(fields: [workflowRunId, projectId], references: [id, projectId], onDelete: Cascade)
  occurrence    NodeOccurrence @relation(fields: [occurrenceId, workflowRunId, projectId, nodeId], references: [id, workflowRunId, projectId, nodeId], onDelete: Cascade, onUpdate: Restrict)
  artifacts     Artifact[]

  @@unique([id, workflowRunId, projectId])
  @@unique([occurrenceId, attempt])
  @@index([workflowRunId])
  @@index([workflowRunId, nodeId])
  @@index([projectId, workflowRunId])
  @@map("node_run")
}

// 先登记 writing，再写私有对象；仅 ready 记录可解析。中途退出保留可追查的 key。
model Artifact {
  id              String      @id @default(uuid()) @db.Uuid
  projectId       String      @db.Uuid
  workflowRunId   String
  nodeRunId       String?     @db.Uuid
  nodeId          String
  outputKey       String
  type            Json
  contentKind     String
  storageKey      String      @unique
  mimeType        String
  size            Int
  checksum        String
  status          String      @default("writing")
  failureStage    String?
  cleanupRequired Boolean     @default(false)
  createdAt       DateTime    @default(now())
  completedAt     DateTime?
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun     WorkflowRun @relation(fields: [workflowRunId, projectId], references: [id, projectId], onDelete: Cascade)
  nodeRun         NodeRun?    @relation(fields: [nodeRunId, workflowRunId, projectId], references: [id, workflowRunId, projectId], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([workflowRunId])
  @@index([nodeRunId])
  @@index([status])
  @@map("artifact")
}

// 用户所有的 Provider Instance。plugin 与 configuration 是执行配置；
// providerDefinitionId 指向代码中的官方定义，直接插件配置时为空。凭证只保存密文。
model ModelProvider {
  id                   String               @id @default(uuid()) @db.Uuid
  ownerId              String
  name                 String               @db.VarChar(80)
  pluginId             String               @db.VarChar(100)
  pluginVersion        Int
  configuration        Json
  providerDefinitionId String?              @db.VarChar(100)
  encryptedCredentials String
  enabled              Boolean              @default(true)
  createdAt            DateTime             @default(now())
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  models               ModelConfiguration[]

  @@unique([id, ownerId])
  @@index([ownerId])
  @@map("model_provider")
}

// 不可变能力 / 模型绑定；Workflow 只保存此 ID，不保存 endpoint 或凭证。
model ModelConfiguration {
  id         String        @id @default(uuid()) @db.Uuid
  ownerId    String
  providerId String        @db.Uuid
  capability String        @db.VarChar(100)
  model      String        @db.VarChar(200)
  settings   Json
  enabled    Boolean       @default(true)
  createdAt  DateTime      @default(now())
  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider   ModelProvider @relation(fields: [providerId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([ownerId])
  @@index([providerId])
  @@map("model_configuration")
}

// 执行命令的持久交付及去重记录，payload 只保存共享 Job，不保存图状态。
model WorkflowExecutionOutbox {
  id              String      @id @default(uuid())
  kind            String
  workflowRunId   String
  waitingRevision Int         @default(0)
  payload         Json
  status          String      @default("pending")
  createdAt       DateTime    @default(now())
  publishedAt     DateTime?
  completedAt     DateTime?
  attempts        Int         @default(0)
  availableAt     DateTime    @default(now())
  workflowRun     WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([workflowRunId, kind, waitingRevision])
  @@index([status, availableAt, createdAt])
  @@map("workflow_execution_outbox")
}
