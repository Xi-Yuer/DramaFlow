generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// 业务模型由用户逐步指导后添加。

model User {
  id            String       @id
  name          String       @db.VarChar(80)
  email         String       @unique @db.VarChar(254)
  emailVerified Boolean      @default(false)
  image         String?
  role          String       @default("user") @db.VarChar(32)
  banned        Boolean      @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?
  projects      Project[]

  @@map("auth_user")
}

model UserProfile {
  userId    String   @id
  bio       String   @default("") @db.VarChar(280)
  locale    String   @default("zh-CN") @db.VarChar(32)
  timeZone  String   @default("Asia/Shanghai") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limit")
}

// 项目保存基础画布信息；Workflow 定义与运行入口独立接入。
model Project {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String
  name         String        @db.VarChar(80)
  revision     Int           @default(1)
  viewport     Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workflow     Workflow?
  nodeRuns     NodeRun[]
  workflowRuns WorkflowRun[]

  @@index([ownerId, updatedAt, id])
  @@map("canvas_project")
}

model Workflow {
  id        String            @id @default(uuid())
  projectId String            @unique @db.Uuid
  name      String            @db.VarChar(80)
  draft     Json
  revision  Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  WorkflowVersion[]

  @@map("workflow")
}

// 每个版本独立保存完整定义；迁移中的触发器禁止更新已创建版本。
model WorkflowVersion {
  id             String   @id @default(uuid())
  workflowId     String
  version        Int
  sourceRevision Int
  definition     Json
  createdAt      DateTime @default(now())
  workflow       Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@unique([workflowId, sourceRevision])
  @@index([workflowId])
  @@map("workflow_version")
}

// 运行仍保存逻辑版本 ID，由 Runner 经版本 Repository 核对归属；本轮不调整运行外键。
model WorkflowRun {
  id                String    @id @default(uuid())
  projectId         String    @db.Uuid
  workflowId        String
  workflowVersionId String
  threadId          String    @unique
  status            String    @default("pending")
  inputs            Json
  outputs           Json?
  error             Json?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodeRuns          NodeRun[]

  @@unique([id, projectId])
  @@index([projectId])
  @@index([workflowId])
  @@index([workflowVersionId])
  @@index([status])
  @@map("workflow_run")
}

model NodeRun {
  id            String      @id @default(uuid()) @db.Uuid
  projectId     String      @db.Uuid
  workflowRunId String
  nodeId        String
  attempt       Int
  status        String      @default("running")
  inputs        Json?
  outputs       Json?
  error         Json?
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun   WorkflowRun @relation(fields: [workflowRunId, projectId], references: [id, projectId], onDelete: Cascade)

  @@unique([workflowRunId, nodeId, attempt])
  @@index([workflowRunId])
  @@index([workflowRunId, nodeId])
  @@index([projectId, workflowRunId])
  @@map("node_run")
}
