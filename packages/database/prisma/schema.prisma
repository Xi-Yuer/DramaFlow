generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// 业务模型由用户逐步指导后添加。

model User {
  id            String   @id
  name          String   @db.VarChar(80)
  email         String   @unique @db.VarChar(254)
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("user") @db.VarChar(32)
  banned        Boolean  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?
  projects      Project[]
  pluginInstallations PluginInstallation[]

  @@map("auth_user")
}

model UserProfile {
  userId    String   @id
  bio       String   @default("") @db.VarChar(280)
  locale    String   @default("zh-CN") @db.VarChar(32)
  timeZone  String   @default("Asia/Shanghai") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limit")
}

// 一个项目就是一张画布；未来运行快照独立建模，不能复用可变草稿。
model Project {
  id         String   @id @default(uuid()) @db.Uuid
  ownerId    String
  name       String   @db.VarChar(80)
  revision   Int      @default(1)
  definition Json
  viewport   Json
  nodeCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt, id])
  @@map("canvas_project")
}

// 插件安装只保存加密后的凭证。明文密钥不能进入这个模型的查询结果。
model PluginInstallation {
  id            String   @id @default(uuid()) @db.Uuid
  ownerId       String
  pluginId      String   @db.VarChar(80)
  pluginVersion Int
  label         String   @db.VarChar(80)
  secretCipher  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@map("plugin_installation")
}
