generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  owner
  admin
  editor
  viewer
}

enum RunStatus {
  queued
  running
  waiting
  succeeded
  failed
  canceled
}

enum OperationStatus {
  prepared
  submitted
  succeeded
  failed
  outcome_unknown
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  members WorkspaceMember[]
}

model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}

model Workspace {
  id String @id @default(uuid())
  name String
  slug String @unique
  createdAt DateTime @default(now())
  members WorkspaceMember[]
  workflows Workflow[]
  installations PluginInstallation[]
  connections ModelConnection[]
  assets Asset[]
  runs Run[]
  conversations Conversation[]
}

model WorkspaceMember {
  id String @id @default(uuid())
  workspaceId String
  userId String
  role WorkspaceRole
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([workspaceId, userId])
  @@index([userId])
}

model Workflow {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  description String @default("")
  draft Json
  draftRevision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions WorkflowVersion[]
  runs Run[]
  conversations Conversation[]
  suggestions Suggestion[]
  @@index([workspaceId, updatedAt])
}

model WorkflowVersion {
  id String @id @default(uuid())
  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  number Int
  definition Json
  sourceRevision Int @default(1)
  publishedBy String
  createdAt DateTime @default(now())
  runs Run[]
  @@unique([workflowId, number])
}

model PluginInstallation {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pluginId String
  pluginVersion String
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workspaceId, pluginId, pluginVersion])
}

model ModelConnection {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  pluginId String
  pluginVersion String
  encryptedSecret String
  configuration Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId])
}

model Asset {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  kind String
  createdAt DateTime @default(now())
  versions AssetVersion[]
  @@index([workspaceId, createdAt])
}

model AssetVersion {
  id String @id @default(uuid())
  assetId String
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  number Int
  mimeType String
  size Int
  checksum String
  storageType String
  storageKey String
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  @@unique([assetId, number])
}

model Run {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  versionId String
  version WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  status RunStatus @default(queued)
  inputs Json @default("{}")
  output Json?
  error Json?
  requestedBy String
  idempotencyKey String
  cancelRequestedAt DateTime?
  parentRunId String?
  regenerateNodeId String?
  continueDownstream Boolean @default(true)
  invalidatedNodeIds Json @default("[]")
  configOverrides Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startedAt DateTime?
  finishedAt DateTime?
  attempts NodeAttempt[]
  events RunEvent[]
  tasks HumanTask[]
  operations Operation[]
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([status, updatedAt])
}

model NodeAttempt {
  id String @id @default(uuid())
  runId String
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId String
  attempt Int @default(1)
  status String
  input Json?
  output Json?
  error Json?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  @@unique([runId, nodeId, attempt])
}

model RunEvent {
  id BigInt @id @default(autoincrement())
  runId String
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  type String
  nodeId String?
  data Json
  createdAt DateTime @default(now())
  @@index([runId, id])
}

model HumanTask {
  id String @id @default(uuid())
  runId String
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId String
  interruptId String
  payload Json
  response Json?
  respondedBy String?
  respondedAt DateTime?
  responseKey String?
  resumedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([runId, interruptId])
  @@index([runId, respondedAt])
}

model Operation {
  id String @id
  runId String?
  run Run? @relation(fields: [runId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  nodeId String
  attemptId String
  status OperationStatus @default(prepared)
  requestHash String
  request Json @default("{}")
  providerRequestId String?
  externalTaskId String?
  result Json?
  error Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([runId, nodeId])
}

model Conversation {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  scope String
  nodeId String @default("")
  model Json
  createdAt DateTime @default(now())
  messages ChatMessage[]
  summaries ConversationSummary[]
  traces ContextTrace[]
  operations Operation[]
  @@unique([workflowId, scope, nodeId])
}

model ChatMessage {
  id String @id @default(uuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role String
  content String
  assetVersionRefs Json @default("[]")
  metadata Json @default("{}")
  requestKey String?
  createdAt DateTime @default(now())
  @@index([conversationId, createdAt])
  @@unique([conversationId, requestKey])
}

model ConversationSummary {
  id String @id @default(uuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessageIds Json
  content String
  modelRef Json
  createdAt DateTime @default(now())
}

model ContextTrace {
  id String @id @default(uuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestMessageId String
  manifest Json
  usage Json?
  createdAt DateTime @default(now())
}

model Suggestion {
  id String @id @default(uuid())
  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  conversationId String
  baseRevision Int
  patch Json
  title String
  explanation String
  status String @default("pending")
  appliedBy String?
  appliedAt DateTime?
  idempotencyKey String? @unique
  createdAt DateTime @default(now())
  @@index([workflowId, createdAt])
}
