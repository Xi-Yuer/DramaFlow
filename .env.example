# 推荐 pnpm env:init 自动生成随机密码和密钥；不要在生产沿用示例占位符。
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://dramaflow:replace-with-random-password@localhost:5432/dramaflow
REDIS_URL=redis://localhost:6379
# 同一业务数据库的 API / Worker 必须使用相同队列前缀。
WORKFLOW_QUEUE_PREFIX=dramaflow-workflow
WORKFLOW_WORKER_CONCURRENCY=4
WEB_ORIGIN=http://localhost:3000
# 32 字节 AES key 的十六进制表示（64字符）
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
API_URL=http://localhost:3001
PORT=3001
# 需要下载供应商 URL 形式产物时，按实际 origin 配置；base64 产物不需要此项。
# RustFS S3 API；控制台 http://localhost:9001/rustfs/console/，使用以下凭证登录。
# Compose 内应用固定通过 http://rustfs:9000 访问。
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dramaflow
S3_ACCESS_KEY_ID=replace-with-random-access-key
S3_SECRET_ACCESS_KEY=replace-with-random-secret-key

# 认证；上线时填写实际 HTTPS 站点地址。运行 env:init 自动生成随机秘密与初始密码。
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@dramaflow.local
ADMIN_NAME=管理员
ADMIN_PASSWORD=replace-with-a-unique-strong-password
# 可选：额外账号开通后删除 NEW_USER_PASSWORD，不要把密码作为命令行参数。
# NEW_USER_EMAIL=member@example.com
# NEW_USER_NAME=创作者
# NEW_USER_PASSWORD=
# 仅信任实际反向代理地址或网段；默认不信任转发头。
# TRUSTED_PROXY_CIDRS=
