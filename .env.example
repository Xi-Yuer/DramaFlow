# 推荐 pnpm env:init 自动生成随机密码和密钥；不要在生产沿用示例占位符。
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://dramaflow:replace-with-random-password@localhost:5432/dramaflow
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
# 32 字节 AES key 的十六进制表示（64字符）
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
API_URL=http://localhost:3001
PORT=3001
# 需要下载供应商 URL 形式产物时，按实际 origin 配置；base64 产物不需要此项。
# RustFS S3 API；控制台 http://localhost:9001/rustfs/console/，使用以下凭证登录。
# Compose 内应用固定通过 http://rustfs:9000 访问。
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dramaflow
S3_ACCESS_KEY_ID=replace-with-random-access-key
S3_SECRET_ACCESS_KEY=replace-with-random-secret-key
